# Copy to .env.local for development. Add production values in Vercel settings.
# Never commit .env.local or put server-only keys in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative to the publishable key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
# Legacy alternative to the server secret key:
# SUPABASE_SERVICE_ROLE_KEY=

# Exact owner email. All data APIs validate the signed-in user against this.
REMY_ALLOWED_EMAIL=
APP_ORIGIN=http://127.0.0.1:5173

# Generate independently in a password manager; never paste values into chat.
# Encryption key: at least 32 random characters. Keep it to decrypt connections.
SECRET_ENCRYPTION_KEY=
# Cron: at least 32 random characters. Vercel sends it as Authorization: Bearer.
CRON_SECRET=
# The owner UUID from Supabase Authentication > Users (not their email).
SYNC_OWNER_ID=

# Optional OAuth apps, created in each provider's developer portal.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Optional single-owner fallbacks. Prefer saving these through Connections.
# Both are ignored for other owners and require SYNC_OWNER_ID.
TREDICT_TOKEN=
RUNNA_FEED_URL=

# Optional access-request notifications; all three are required, server-only.
# Use a Resend-authorized sender mailbox (plain address, no display name).
# The notification inbox is separate from REMY_ALLOWED_EMAIL; no fallback is used.
RESEND_API_KEY=
ACCESS_REQUEST_FROM_EMAIL=
ACCESS_REQUEST_TO_EMAIL=
